NODE_ENV=development
HOST=127.0.0.1
PORT=5005

MONGODB_URI=
MONGODB_DB_NAME=cctv_ai

CV_SERVICE_TOKEN=

CORS_ORIGIN=http://localhost:5173
REPORT_TIMEZONE=Asia/Jakarta
HEARTBEAT_TIMEOUT_SECONDS=90
LIVE_PREVIEW_ENABLED=true
LIVE_PREVIEW_MAX_FRAME_BYTES=524288
LIVE_PREVIEW_MAX_SUBSCRIBERS_PER_CAMERA=5
LIVE_PREVIEW_STALE_SECONDS=10

# Private person-capture storage and protected operator access
PERSON_CAPTURE_STORAGE_DIR=storage/person-captures
PERSON_CAPTURE_MAX_FILE_BYTES=524288
PERSON_CAPTURE_MAX_WIDTH=2048
PERSON_CAPTURE_MAX_HEIGHT=4096
PERSON_CAPTURE_RETENTION_DAYS=7
PERSON_CAPTURE_REVIEWED_RETENTION_DAYS=30
PERSON_CAPTURE_LINE_IDS=entry-line
OPERATOR_ID=local-operator
OPERATOR_TOKEN=
CREDENTIAL_PEPPER=
CREDENTIAL_TTL_SECONDS=600
DATASET_EXPORT_DIR=../../../cv/data/datasets
DATASET_TRAINING_ENABLED=false
ACTIVE_IDENTITY_TTL_SECONDS=180

LOG_LEVEL=info
