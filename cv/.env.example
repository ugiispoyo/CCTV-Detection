# API
API_BASE_URL=http://127.0.0.1:5005
CV_SERVICE_TOKEN=
WORKER_ID=cv-worker-001
CAMERA_ID=cam-001

# Camera
RTSP_URL=
CAMERA_CONFIG=config/cameras.yaml
H9C_LENS_1_RTSP_URL=
H9C_LENS_2_RTSP_URL=
RTSP_TRANSPORT=tcp
RTSP_CONNECT_TIMEOUT_MS=10000
RTSP_READ_TIMEOUT_MS=10000
RTSP_RECONNECT_INITIAL_SECONDS=2
RTSP_RECONNECT_MAX_SECONDS=30

# YOLO
MODEL_PATH=yolo26n.pt
EXPERIMENTAL_HYBRID_DETECTOR_ENABLED=false
CUSTOM_DETECTOR_MODEL_PATH=
DEVICE=auto
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.50
IMAGE_SIZE=640

# Processing
TARGET_PROCESSING_FPS=10
CV_HEADLESS=true
LOCAL_PREVIEW_ENABLED=false

# Live AI Preview
LIVE_PREVIEW_ENABLED=true
LIVE_PREVIEW_FPS=5
LIVE_PREVIEW_WIDTH=960
LIVE_PREVIEW_JPEG_QUALITY=70
LIVE_PREVIEW_MAX_FRAME_BYTES=524288
CV_PREVIEW_WS_URL=ws://127.0.0.1:5005/internal/cv/preview
CV_PREVIEW_RECONNECT_INITIAL_SECONDS=2
CV_PREVIEW_RECONNECT_MAX_SECONDS=30

# Counting
COUNTING_LINE_X1=0.10
COUNTING_LINE_Y1=0.60
COUNTING_LINE_X2=0.90
COUNTING_LINE_Y2=0.60
COUNTING_MARGIN=8
COUNTING_DIRECTION_IN=negative_to_positive
COUNTING_ANCHOR=bottom_center
COUNTING_REARM_SECONDS=1.5

# API Delivery
API_TIMEOUT_SECONDS=5
EVENT_RETRY_INITIAL_SECONDS=2
EVENT_RETRY_MAX_SECONDS=60

# Monitoring
HEARTBEAT_INTERVAL_SECONDS=15
METRICS_INTERVAL_SECONDS=30

# SQLite
EVENT_QUEUE_DATABASE=data/events.sqlite3
EVENT_QUEUE_MAX_PENDING=10000
EVENT_QUEUE_RETAIN_DELIVERED=false

# Logging
LOG_LEVEL=INFO

# Person Capture (manual labeling only; no biometric matching)
PERSON_CAPTURE_ENABLED=true
PERSON_CAPTURE_TRIGGER=line_crossing
PERSON_CAPTURE_DIRECTION=both
PERSON_FULL_BODY_CROP_ENABLED=true
PERSON_CAPTURE_MIN_CONFIDENCE=0.65
PERSON_CAPTURE_MIN_WIDTH=80
PERSON_CAPTURE_MIN_HEIGHT=140
PERSON_CAPTURE_PADDING=0.10
PERSON_CAPTURE_JPEG_QUALITY=85
PERSON_CAPTURE_MAX_CANDIDATES=5
PERSON_CAPTURE_BUFFER_SECONDS=3
PERSON_HEAD_CROP_ENABLED=true
# Supply a locally reviewed Ultralytics-compatible head object detector.
# Record its origin/version/license in cv/docs/head-detector.md. No model is downloaded automatically.
HEAD_DETECTION_MODEL_PATH=
HEAD_DETECTION_ALLOW_OPENCV_FALLBACK=true
HEAD_DETECTION_MIN_CONFIDENCE=0.25
HEAD_CROP_PADDING=0.15
HEAD_CROP_MIN_WIDTH=24
HEAD_CROP_MIN_HEIGHT=24
PERSON_CAPTURE_MAX_FILE_BYTES=524288
PERSON_CAPTURE_STORAGE_DIR=data/snapshots
PERSON_CAPTURE_RETENTION_DAYS=7
PERSON_CAPTURE_RETRY_INITIAL_SECONDS=2
PERSON_CAPTURE_RETRY_MAX_SECONDS=60

# Curated detection dataset and administrator-initiated training
DATASET_EXPORT_DIR=data/datasets
DATASET_TRAINING_ENABLED=false
